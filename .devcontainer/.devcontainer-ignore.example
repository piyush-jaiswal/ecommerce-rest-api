# Example file for .devcontainer-ignore
# Purpose: Prevent sensitive or unwanted files and folders from being mounted to devcontainers. (Wildcards not supported)
# Creates an empty directory for each entry, shadowing the corresponding host system paths. Files are shadowed with a read-only /dev/null mount
# Writes to them not retained on rebuilds
# Entries that do not exist on the host are skipped

venv
__pycache__
.pytest_cache
.mypy_cache
.ruff_cache
dist
build